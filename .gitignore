# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# PyInstaller build artifacts
build/
dist/
*.spec
!gui/LeadEngine.spec   # this one is source (our build recipe), keep it

# GUI run outputs (generated lead files)
gui/_output/*
!gui/_output/.gitkeep

# Data files (don't commit huge parquet/csv to git)
*.parquet
*.csv
*.xlsx
!data-kit/sample_*.xlsx
data-kit/sonoma_places.*
data-kit/sonoma_businesses.*

# Committed lead deliverables: the CSV/JSONL/xlsx exports + data dictionaries
# under lead-tracker/data/export/ ARE tracked so the CRM build has the data on
# hand. Overture is CC-BY; redistribution is fine with attribution (see the
# DATA_DICTIONARY.md files). Heavy regenerable artifacts (.sqlite, raw parquet)
# stay ignored via lead-tracker/.gitignore.
!lead-tracker/data/export/**

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# OS
Thumbs.db
